VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_API_URL=http://localhost:8000

# Google OAuth Setup (configure in Supabase Dashboard):
# 1. Go to Authentication > Providers > Google in your Supabase project
# 2. Enable Google provider and enter your Google Cloud Client ID & Secret
#    (Create one at https://console.cloud.google.com/apis/credentials)
# 3. Add this Authorized redirect URI in Google Cloud Console:
#    https://<your-project-ref>.supabase.co/auth/v1/callback
# 4. In Supabase Auth > URL Configuration, add your site URLs:
#    - Site URL: your production app URL (e.g. https://yourapp.com)
#    - Redirect URLs: http://localhost:5173/* (dev) and https://yourapp.com/* (prod)
# No additional frontend env vars needed — Google OAuth uses Supabase JS SDK directly.
